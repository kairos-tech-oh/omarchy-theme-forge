#!/bin/bash

# Theme Forge helper -- the only part of this plugin that touches the
# filesystem, runs another program, or changes anything about the desktop.
#
# The QML side does all of the colour maths and none of the I/O. Everything with
# a consequence is here, in one file, invoked as an argv array from Quickshell's
# Process (so no shell parses any of these arguments) and with every payload that
# could be long or hostile arriving on stdin rather than in argv.
#
# Usage:
#
#   theme-forge [--budget N] <command> [args...]
#
# --budget is a ceiling for the whole invocation, not for each program it runs.
# N paths at 25 seconds each is not a 25 second limit.
#
#   scratch                  create and verify the private working directory
#   probe <path>             refuse an image before any decoder sees it
#   quantize <path> <n>      the n dominant colours of an image, as hex
#   thumb <path>             a bounded downscale into the scratch directory
#   wallpaper <name>         draw a background from the palette on stdin
#   adopt <name> <path>      copy a probed image in as the theme's background
#   save <name> [icons] [--wip]  write colors.toml, read from stdin
#   preview <name> <path> <bg>   the grabbed mock desktop as preview.png
#   verify <name>            what Omarchy and omarchy.org need, as a report
#   pick-dir                 the desktop folder chooser
#   export <name> <dir>      build a submission-ready git repository
#   list-wip                 the in-progress theme names
#   discard-wip <name>       remove an in-progress theme, once it has been kept
#   apply <name>             omarchy-theme-set
#   list                     the user's own theme names
#   locked                   the user themes this refuses to write to, and why
#   stock                    the theme names Omarchy ships
#   current                  the theme name in use right now
#   load <name>              print an existing theme's colors.toml
#   draft-save               store the in-progress palette, read from stdin
#   draft-load               print it back
#   prefs-save               store the user's preferences, read from stdin
#   prefs-load               print them back
#
# Exit codes are the interface. 0 is fine, 1 is a refusal with a reason on
# stderr, and anything the QML side needs to distinguish gets its own number.

set -uo pipefail

# Byte-exact character classes. Under a UTF-8 locale a bracket range follows
# collation order, so `[a-z]` and `[ -~]` are not the ASCII sets they read as.
export LC_ALL=C

EXIT_OK=0
EXIT_REFUSED=1
EXIT_NO_SCRATCH=7
EXIT_TOO_BIG=8
EXIT_NO_TOOL=9
EXIT_TIMEOUT=10

# ----------------------------------------------------------------- ceilings
#
# Every one of these is applied at the producer, before the bytes exist, not
# checked afterwards. A ceiling downstream of the allocation it claims to
# prevent is not a ceiling.

# ImageMagick's histogram of 8 colours measured 640 bytes. 64 KiB is a hundred
# times that and is still a hard bound on what can be held.
QUANTIZE_CAP=65536

# colors.toml is 26 short lines. A generated one measured 1.1 KiB.
TOML_CAP=16384

# The draft is one JSON object of a few dozen hex strings.
DRAFT_CAP=65536

# Preferences are a handful of booleans and a number. Kept separate from the
# draft on purpose: the draft is work in progress and is cleared freely, while
# "I have seen the tutorial" has to survive that.
PREFS_CAP=8192

# A theme name is at most 32 characters; a directory listing of them is small.
LIST_CAP=32768

# icons.theme is one word. The README and LICENSE an export writes are a page.
ICONS_CAP=64
DOC_CAP=32768

# PATH_MAX is 4096, so a longer reply is not a path this system can open.
PATH_CAP=4096

# A 4K JPEG at quality 92 measured 877 KiB. 12 MB is more than ten times that
# and is still a hard bound on what an encode can be made to write.
IMAGE_CAP=12000000

# The most an image the user picked may be, on disk. A 4K PNG measured 18 MiB.
IMAGE_READ_CAP=67108864

# What ImageMagick may spend on any single invocation, regardless of the input.
# The header probe refuses the obvious cases before a decoder runs, and the
# decoder is then fed the same bytes the probe passed; this is the bound on
# what decoding them may cost. It is also in a separate process, which can be
# killed without taking omarchy-shell with it.
IM_LIMITS=(-limit memory 256MiB -limit map 256MiB -limit area 64MP -limit time 25 -limit thread 2)

WALLPAPER_WIDTH=3840
WALLPAPER_HEIGHT=2160

# 16:9, the shape omarchy.org's theme grid is laid out in.
PREVIEW_WIDTH=1920
PREVIEW_HEIGHT=1080

OMARCHY_ROOT="${OMARCHY_PATH:-/usr/share/omarchy}"
THEMES_DIR="$HOME/.config/omarchy/themes"
STATE_DIR="$HOME/.local/state/kairos.theme-forge"

# In-progress themes live here rather than in ~/.config/omarchy/themes, and that
# is the whole mechanism: omarchy-theme-list enumerates the themes directory, so
# a theme kept outside it simply never appears in the switcher. Same layout, same
# colors.toml, same backgrounds -- just somewhere Omarchy does not look.
WIP_DIR="$STATE_DIR/wip"
CURRENT_NAME_FILE="$HOME/.local/state/omarchy/current/theme.name"

SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
READER="$SELF_DIR/reader.py"

# ------------------------------------------------------------------ budget

BUDGET=30
if [[ ${1:-} == "--budget" ]]; then
  case "${2:-}" in
    ''|*[!0-9]*) BUDGET=30 ;;
    *) BUDGET=$(( 10#$2 )) ;;
  esac
  (( BUDGET < 1 )) && BUDGET=1
  (( BUDGET > 180 )) && BUDGET=180
  shift 2
fi
STARTED_AT=$(date +%s)

# `--wip` may follow the subcommand's own arguments; pull it out wherever it is
# so each command can just ask.
WIP=0
ARGS=()
for arg in "$@"; do
  if [[ $arg == "--wip" ]]; then WIP=1; else ARGS+=("$arg"); fi
done
set -- ${ARGS+"${ARGS[@]}"}

# Seconds left in this invocation's budget.
#
# `timeout 0` means *no limit*, so a budget that has run out would silently
# remove the ceiling instead of enforcing it. Clamped to 1, always.
remaining() {
  local now elapsed left
  now=$(date +%s)
  elapsed=$(( now - STARTED_AT ))
  left=$(( BUDGET - elapsed ))
  (( left < 1 )) && left=1
  printf '%s' "$left"
}

# Everything this helper prints, on either stream, goes through one of these
# two. StdioCollector on the QML side retains a process's complete output before
# any signal fires, so a check after the fact is downstream of the allocation it
# claims to prevent -- the ceiling has to be here, at the producer.
#
# OUT_CAP is generous next to what these actually emit (a path, a theme name, a
# sentence) and is still a hard bound on what the shell can be made to hold.
OUT_CAP=4096

say() {
  printf '%s\n' "${1:0:$OUT_CAP}"
}

refuse() {
  printf 'theme-forge: %s\n' "${1:0:$OUT_CAP}" >&2
  exit "${2:-$EXIT_REFUSED}"
}

need_tool() {
  command -v "$1" >/dev/null 2>&1 || refuse "$1 is not installed" "$EXIT_NO_TOOL"
}

# Which ImageMagick this box has. v7 is `magick`; v6 is `convert`, and its
# `convert` is not the same program as coreutils' -- checking for `magick` first
# is what keeps us off any other `convert` on PATH.
magick_bin() {
  if command -v magick >/dev/null 2>&1; then printf 'magick'
  elif command -v convert >/dev/null 2>&1; then printf 'convert'
  else return 1
  fi
}

# Run a producer under the remaining budget with a hard byte ceiling, and treat
# reaching the ceiling as a failure rather than as data.
#
# The cap is applied by `head -c` inside the pipeline, so the producer is stopped
# at the ceiling rather than being allowed to finish and checked afterwards. One
# byte more than the cap is requested on purpose: reading exactly `cap` bytes of
# an oversized reply yields a valid-looking prefix that would be accepted.
BOUNDED_OUT=""
run_bounded() {
  local cap="$1"; shift
  local status
  BOUNDED_OUT=$(timeout "$(remaining)" "$@" 2>/dev/null | head -c $(( cap + 1 )))
  status=${PIPESTATUS[0]}
  if (( $(printf '%s' "$BOUNDED_OUT" | wc -c) > cap )); then
    BOUNDED_OUT=""
    return "$EXIT_TOO_BIG"
  fi
  if (( status == 124 )); then
    BOUNDED_OUT=""
    return "$EXIT_TIMEOUT"
  fi
  return "$status"
}

# --------------------------------------------------------- private scratch
#
# $XDG_RUNTIME_DIR is /run/user/<uid>, mode 0700 and owned by this user, which
# is the only directory on a normal system that is both private and writable
# without a race. ~/.cache is the fallback.
#
# /tmp is not a fallback. A predictable name there can be pre-created by another
# local user as a symlink, and every write through it lands wherever they chose.
# If neither private directory is usable this fails closed and the image half of
# the plugin greys out with a reason -- a wallpaper is an ornament, and failing
# closed costs nothing worth a foothold.
scratch_dir() {
  local base dir
  for base in "${XDG_RUNTIME_DIR:-}" "${HOME:-}/.cache"; do
    [[ -n $base && $base != "/.cache" ]] || continue
    dir="$base/kairos-theme-forge"
    mkdir -m 700 -p -- "$dir" 2>/dev/null || continue
    # -O is the one that matters: a directory someone else created first is
    # theirs, whatever its mode says.
    if [[ -d $dir && ! -L $dir && -O $dir ]]; then
      printf '%s' "$dir"
      return 0
    fi
  done
  return 1
}

require_scratch() {
  local dir
  dir=$(scratch_dir) || refuse "no private directory is available (tried \$XDG_RUNTIME_DIR and ~/.cache)" "$EXIT_NO_SCRATCH"
  printf '%s' "$dir"
}

# Create a directory and confirm it is ours before anything is written into it.
# -O is the check that matters: a directory someone else created first is theirs,
# whatever its mode says, and a pre-created symlink would redirect every write
# that followed.
require_dir() {
  local dir="$1"
  mkdir -p -- "$dir" 2>/dev/null
  [[ -d $dir && ! -L $dir && -O $dir ]] || refuse "$dir is not a directory this can write to"
}

# Write stdin to a path that must not already exist, through reader.py's
# O_CREAT|O_EXCL|O_NOFOLLOW. A fixed scratch name is a name anyone who can write
# to the directory can create first as a symlink; a plain `>` in the shell then
# truncates whatever they pointed it at. O_EXCL means there is nothing to
# redirect. The caller renames the result into place, and rename(2) replaces a
# symlink at the destination rather than following it.
# The mode is explicit because these files have two different audiences. A theme
# is something the user may well publish -- Omarchy installs one by cloning a git
# repo -- so its files are ordinary 0644 content. The draft is this plugin's own
# state and stays 0600.
write_new() {
  local target="$1" cap="$2" mode="${3:-0600}"
  rm -f -- "$target"
  timeout "$(remaining)" python3 "$READER" write "$target" "$cap" "$mode"
}

state_dir() {
  local dir="$STATE_DIR"
  mkdir -m 700 -p -- "$dir" 2>/dev/null || return 1
  [[ -d $dir && ! -L $dir && -O $dir ]] || return 1
  printf '%s' "$dir"
}

# --------------------------------------------------------------- the name
#
# The name becomes a directory that gets written, a filename prefix, and an
# argument to omarchy-theme-set. This is deliberately stricter than
# omarchy-theme-set's own check, and it refuses rather than repairs: silently
# turning `../evil` into `evil` would write a real theme under a name the user
# never asked for.
#
# The same rule lives in Sanitise.js. Both are load-bearing -- the QML side keeps
# the UI honest, and this one is what actually guards the filesystem, because a
# helper is a program anyone can run.
valid_name() {
  local name="$1"
  [[ -n $name ]] || return 1
  (( ${#name} <= 32 )) || return 1
  [[ $name =~ ^[a-z0-9][a-z0-9-]*$ ]] || return 1
  return 0
}

require_name() {
  local name="${1:-}"
  valid_name "$name" || refuse "'$name' is not a usable theme name (a-z, 0-9 and dashes, up to 32 characters)"
  printf '%s' "$name"
}

# Everything above, plus the three things that make a name valid but not ours to
# write to.
# Where a theme of this name lives, given the mode.
theme_root() {
  if (( WIP )); then printf '%s' "$WIP_DIR"; else printf '%s' "$THEMES_DIR"; fi
}

require_writable_theme() {
  local name dir
  name=$(require_name "${1:-}") || exit $?

  # An in-progress theme lives inside this plugin's own state directory, which
  # it created and verified. None of the three refusals below can apply there --
  # Omarchy ships nothing into it, nothing clones into it, and a symlink in it
  # would be ours. Guarding the directory itself is state_dir's job.
  if (( WIP )); then
    require_dir "$WIP_DIR"
    printf '%s' "$name"
    return 0
  fi

  dir="$THEMES_DIR/$name"

  if [[ -d "$OMARCHY_ROOT/themes/$name" ]]; then
    refuse "'$name' is one of Omarchy's own themes -- pick another name"
  fi
  # `omarchy theme install` clones into this directory, so a .git inside one
  # means the contents came from someone else. Overwriting it is not ours to do.
  if [[ -e "$dir/.git" ]]; then
    refuse "'$name' was installed from a git repository -- Theme Forge will not overwrite it"
  fi
  # A symlink here is the user's own working copy living somewhere else. Writing
  # through it would write to a directory they did not name.
  if [[ -L $dir ]]; then
    refuse "'$name' is a symlink to a working copy -- edit it there instead"
  fi
  printf '%s' "$name"
}

# ------------------------------------------------------------------ colours

valid_hex() {
  [[ ${1:-} =~ ^#[0-9a-f]{6}$ ]]
}

# The declared format of an image the user picked, after the header probe has
# passed it. Exits with the probe's own code otherwise.
probe_format() {
  local info
  need_tool python3
  info=$(timeout "$(remaining)" python3 "$READER" probe "$1") || exit $?
  printf '%s' "${info%% *}"
}

# The image's bytes on stdout, from one guarded open, re-probed as the bytes
# they are. ImageMagick reads them from stdin under a pinned coder, so the path
# the user picked never reaches a program that would parse `coder:`, `[scene]`
# or `@file` out of it, and what it decodes is exactly what the probe passed.
image_stream() {
  timeout "$(remaining)" python3 "$READER" image "$1" "$IMAGE_READ_CAP" "$2" 2>/dev/null
}

# ----------------------------------------------------------------- commands

cmd_scratch() {
  local dir
  # Not `say "$(require_scratch)"`: refuse() exits, and inside a command
  # substitution it exits the *subshell*, so the caller would see success and an
  # empty path rather than the refusal.
  dir=$(scratch_dir) || refuse "no private directory is available (tried \$XDG_RUNTIME_DIR and ~/.cache)" "$EXIT_NO_SCRATCH"
  say "$dir"
}

# The desktop portal's file chooser, run here rather than straight from QML so
# its reply passes the same byte ceiling as every other producer. A portal is
# another program answering over D-Bus; nothing about it makes its output
# self-limiting.
cmd_pick() {
  need_tool omarchy-file-select
  # The chooser waits on a human, so it gets its own generous deadline rather
  # than the request budget -- but it still gets one.
  BOUNDED_OUT=$(timeout 600 omarchy-file-select \
      --title "Background image for this theme" \
      --extensions "png jpg jpeg webp" 2>/dev/null | head -c $(( PATH_CAP + 1 )))
  local status=${PIPESTATUS[0]}
  (( $(printf '%s' "$BOUNDED_OUT" | wc -c) > PATH_CAP )) && refuse "that path is longer than this system can open" "$EXIT_TOO_BIG"
  (( status != 0 )) && exit "$status"
  say "$BOUNDED_OUT"
}

cmd_probe() {
  local path="${1:-}"
  [[ -n $path ]] || refuse "probe needs a path"
  need_tool python3
  timeout "$(remaining)" python3 "$READER" probe "$path"
  local status=$?
  (( status == 124 )) && refuse "reading that image took too long" "$EXIT_TIMEOUT"
  exit "$status"
}

cmd_quantize() {
  local path="${1:-}" count="${2:-6}" bin fmt
  [[ -n $path ]] || refuse "quantize needs a path"
  case "$count" in ''|*[!0-9]*) count=6 ;; esac
  (( count < 2 )) && count=2
  (( count > 12 )) && count=12

  # The probe is the gate: nothing reaches a decoder until the file's own header
  # has been read and its declared size refused.
  fmt=$(probe_format "$path") || exit $?
  bin=$(magick_bin) || refuse "ImageMagick is not installed" "$EXIT_NO_TOOL"

  # -alpha remove -alpha off before the histogram, so every colour comes back as
  # six hex digits rather than eight. Capped by head -c inside the pipeline, so
  # the producer is stopped at the ceiling rather than checked afterwards.
  BOUNDED_OUT=$(image_stream "$path" "$fmt" \
    | timeout "$(remaining)" "$bin" "${IM_LIMITS[@]}" "$fmt:-" \
        -auto-orient -resize 320x320 -alpha remove -alpha off \
        -depth 8 -colors "$count" -format %c histogram:info:- 2>/dev/null \
    | head -c $(( QUANTIZE_CAP + 1 )))
  local statuses=("${PIPESTATUS[@]}")
  (( $(printf '%s' "$BOUNDED_OUT" | wc -c) > QUANTIZE_CAP )) \
    && refuse "that image produced more colour data than expected" "$EXIT_TOO_BIG"
  (( statuses[0] == 124 || statuses[1] == 124 )) \
    && refuse "reading the colours out of that image took too long" "$EXIT_TIMEOUT"
  (( statuses[0] != 0 )) && refuse "that image could not be read"
  (( statuses[1] != 0 )) && refuse "ImageMagick could not read that image"

  # Sort by pixel count so the dominant colours come first. The input is at most
  # `count` rows and was byte-capped before it got here, so the sort -- which
  # must consume all of its input before emitting anything -- is bounded by the
  # ceiling already applied upstream of it, not by this pipeline.
  printf '%s\n' "$BOUNDED_OUT" \
    | sed -n 's/^ *\([0-9]\{1,12\}\):.*\(#[0-9A-Fa-f]\{6\}\).*$/\1 \2/p' \
    | sort -rn -k1,1 \
    | head -n "$count" \
    | awk '{ print tolower($2) }'
}

cmd_thumb() {
  local path="${1:-}" dir bin out tmp fmt
  [[ -n $path ]] || refuse "thumb needs a path"
  fmt=$(probe_format "$path") || exit $?

  dir=$(require_scratch) || exit $?
  bin=$(magick_bin) || refuse "ImageMagick is not installed" "$EXIT_NO_TOOL"
  out="$dir/preview.jpg"
  tmp="$dir/preview.jpg.new"

  image_stream "$path" "$fmt" \
    | timeout "$(remaining)" "$bin" "${IM_LIMITS[@]}" "$fmt:-" \
        -auto-orient -thumbnail 1280x720 -strip -quality 88 JPEG:- 2>/dev/null \
    | write_new "$tmp" "$IMAGE_CAP"
  if (( PIPESTATUS[0] != 0 || PIPESTATUS[1] != 0 )) || [[ ! -f $tmp ]]; then
    rm -f -- "$tmp"
    refuse "could not make a preview of that image"
  fi
  mv -f -- "$tmp" "$out" || refuse "could not write the preview"
  say "$out"
}

# Read `key=value` lines from stdin. Anything that is not a known key with a
# valid value contributes nothing, so a malformed line degrades the wallpaper
# rather than reaching ImageMagick as an argument.
read_palette_stdin() {
  local body line key value
  body=$(head -c "$TOML_CAP")
  P_BG="" P_DARKER="" P_ACCENT="" P_MODE="dark"
  while IFS= read -r line; do
    key=${line%%=*}
    value=${line#*=}
    case "$key" in
      mode) [[ $value == "light" ]] && P_MODE="light" ;;
      background) valid_hex "$value" && P_BG=$value ;;
      darker_background) valid_hex "$value" && P_DARKER=$value ;;
      accent) valid_hex "$value" && P_ACCENT=$value ;;
    esac
  done <<<"$body"
  [[ -n $P_BG && -n $P_DARKER && -n $P_ACCENT ]]
}

cmd_wallpaper() {
  local name dir bin out tmp
  local glow_edge glow_level streak_ground streak_level compose_op
  name=$(require_writable_theme "${1:-}") || exit $?
  read_palette_stdin || refuse "the palette on stdin was incomplete"

  bin=$(magick_bin) || refuse "ImageMagick is not installed" "$EXIT_NO_TOOL"
  dir="$(theme_root)/$name/backgrounds"
  require_dir "$(theme_root)/$name"
  require_dir "$dir"
  out="$dir/0-$name.jpg"
  tmp="$dir/.0-$name.jpg.new"

  # The bloom and the light traces have to be composited differently on a light
  # theme than on a dark one, and it is not a matter of taste: Screen over a
  # near-white ground does nothing at all, and Multiply against a layer whose
  # surround is black turns the whole wallpaper black. So each mode gets the
  # operator that has something to work with, and the layer's surround is the
  # identity colour for that operator -- black for Screen, white for Multiply.
  #
  # +level compresses the layer toward its surround, which is how the effect is
  # kept faint on the light side; -evaluate multiply does the same on the dark
  # side. They are not interchangeable: scaling a white surround toward zero is
  # exactly the black-wallpaper failure above.
  if [[ $P_MODE == "light" ]]; then
    compose_op="Multiply"
    glow_edge="white"; glow_level="+level 78%,100%"
    streak_ground="white"; streak_level="+level 88%,100%"
  else
    compose_op="Screen"
    glow_edge="black"; glow_level="-evaluate multiply 0.24"
    streak_ground="black"; streak_level="-evaluate multiply 0.42"
  fi

  # Composed at 1920x1080 and scaled up at the end. Everything but the grain is
  # a smooth gradient, which loses nothing to the upscale, and it keeps the glow
  # layer -- which has to be far larger than the canvas for its falloff to read
  # as light rather than as a blob -- inside the 64 megapixel area limit. At 4K
  # that same layer would be 81 megapixels on its own.
  #
  # The grain goes on afterwards, at full size, so it stays fine rather than
  # being doubled along with everything else.
  # shellcheck disable=SC2086  # the *_level values are fixed operator strings chosen above
  timeout "$(remaining)" "$bin" "${IM_LIMITS[@]}" \
      -size 1920x1080 "gradient:${P_DARKER}-${P_BG}" \
      \( -size 4500x4500 "radial-gradient:${P_ACCENT}-${glow_edge}" $glow_level \) \
      -gravity NorthWest -geometry -375-2625 -compose "$compose_op" -composite \
      \( -size 1920x1080 "xc:${streak_ground}" -fill none -stroke "${P_ACCENT}" -strokewidth 3 \
         -draw "line -450,1290 2400,-390 line -450,1500 2400,-180 line -450,1740 2400,60 line -450,2100 2400,420" \
         -blur 0x9 $streak_level \) \
      -gravity Center -compose "$compose_op" -composite \
      -resize "${WALLPAPER_WIDTH}x${WALLPAPER_HEIGHT}!" \
      \( -size 480x270 xc:gray50 -attenuate 0.20 +noise Gaussian \
         -resize "${WALLPAPER_WIDTH}x${WALLPAPER_HEIGHT}!" -blur 0x0.6 \) \
      -gravity Center -compose Overlay -composite \
      -quality 92 JPEG:- 2>/dev/null \
    | write_new "$tmp" "$IMAGE_CAP" 0644
  if (( PIPESTATUS[0] != 0 )) || [[ ! -f $tmp ]]; then
    rm -f -- "$tmp"
    refuse "could not draw the background"
  fi
  mv -f -- "$tmp" "$out" || refuse "could not write the background"
  say "$out"
}

cmd_adopt() {
  local name path dir bin out tmp fmt
  name=$(require_writable_theme "${1:-}") || exit $?
  path="${2:-}"
  [[ -n $path ]] || refuse "adopt needs a path"

  # Re-probed here rather than trusted from the earlier probe: the path is one
  # the plugin does not own, and what was checked a moment ago is not
  # necessarily what is there now.
  fmt=$(probe_format "$path") || exit $?

  bin=$(magick_bin) || refuse "ImageMagick is not installed" "$EXIT_NO_TOOL"
  dir="$(theme_root)/$name/backgrounds"
  require_dir "$(theme_root)/$name"
  require_dir "$dir"
  out="$dir/0-$name.jpg"
  tmp="$dir/.0-$name.jpg.new"

  # Re-encoded rather than copied. A copy would carry the original's metadata
  # into a directory the user may publish, and would leave the theme holding a
  # file this plugin never decoded successfully.
  image_stream "$path" "$fmt" \
    | timeout "$(remaining)" "$bin" "${IM_LIMITS[@]}" "$fmt:-" \
        -auto-orient -resize "${WALLPAPER_WIDTH}x${WALLPAPER_HEIGHT}^" \
        -gravity Center -extent "${WALLPAPER_WIDTH}x${WALLPAPER_HEIGHT}" \
        -strip -quality 92 JPEG:- 2>/dev/null \
    | write_new "$tmp" "$IMAGE_CAP" 0644
  if (( PIPESTATUS[0] != 0 || PIPESTATUS[1] != 0 )) || [[ ! -f $tmp ]]; then
    rm -f -- "$tmp"
    refuse "could not use that image as a background"
  fi
  mv -f -- "$tmp" "$out" || refuse "could not write the background"
  say "$out"
}

# Every line colors.toml is allowed to contain. Anything else and the whole file
# is refused: a partly-valid theme that still parses is worse than no theme,
# because it is silently wrong and Omarchy will happily apply it.
TOML_KEYS='accent|selection|muted|background|dark_background|darker_background|lighter_background'
TOML_KEYS+='|foreground|dark_foreground|light_foreground|bright_foreground'
TOML_KEYS+='|red|yellow|orange|green|cyan|blue|magenta|brown'
TOML_KEYS+='|bright_red|bright_yellow|bright_green|bright_cyan|bright_blue|bright_magenta'

# Every icon set Palette.iconTheme is allowed to have chosen. Deliberately the
# plain variants only -- a shorter list is a tighter boundary, and the file's
# whole contents go straight to `gsettings set ... icon-theme`.
ICON_THEMES='Yaru|Yaru-blue|Yaru-magenta|Yaru-olive|Yaru-prussiangreen'
ICON_THEMES+='|Yaru-purple|Yaru-red|Yaru-sage|Yaru-wartybrown|Yaru-yellow'

toml_line_ok() {
  local line="$1"
  [[ -z $line ]] && return 0
  # Theme Forge writes ASCII comments only, so anything else in one is not ours.
  local comment='^#[ -~]{0,400}$'
  [[ $line =~ $comment ]] && return 0
  [[ $line =~ ^mode\ =\ \"(dark|light)\"$ ]] && return 0
  [[ $line =~ ^($TOML_KEYS)\ =\ \"#[0-9a-f]{6}\"$ ]] && return 0
  [[ $line =~ ^hyprland_active_border\ =\ \"rgba\([0-9a-f]{8}\)\ rgba\([0-9a-f]{8}\)\ 45deg\"$ ]] && return 0
  [[ $line =~ ^hyprland_inactive_border\ =\ \"rgba\([0-9a-f]{8}\)\"$ ]] && return 0
  return 1
}

cmd_save() {
  local name icons dir body line count tmp
  name=$(require_writable_theme "${1:-}") || exit $?
  icons="${2:-}"
  # Re-checked here rather than trusted from Palette.iconTheme: the value is
  # about to become the whole contents of a file Omarchy hands to gsettings.
  [[ -z $icons || $icons =~ ^($ICON_THEMES)$ ]] \
    || refuse "'$icons' is not an icon set this will write"

  body=$(head -c $(( TOML_CAP + 1 )))
  if (( $(printf '%s' "$body" | wc -c) > TOML_CAP )); then
    refuse "that palette is larger than a colors.toml has any reason to be" "$EXIT_TOO_BIG"
  fi
  [[ -n $body ]] || refuse "nothing arrived on stdin"

  count=0
  while IFS= read -r line; do
    count=$(( count + 1 ))
    (( count > 200 )) && refuse "that palette has more lines than a colors.toml has any reason to"
    toml_line_ok "$line" || refuse "refusing to write a colors.toml containing: $line"
  done <<<"$body"

  dir="$(theme_root)/$name"
  require_dir "$dir"
  require_dir "$dir/backgrounds"
  tmp="$dir/.colors.toml.new"
  printf '%s\n' "$body" | write_new "$tmp" "$TOML_CAP" 0644 || refuse "could not write $tmp"
  mv -f -- "$tmp" "$dir/colors.toml" || refuse "could not write $dir/colors.toml"

  # The one setting no Omarchy template derives, so a theme without it gets
  # Yaru-blue whatever its palette is. Written after colors.toml and never
  # instead of it: a theme with icons and no palette is not a theme.
  if [[ -n $icons ]]; then
    tmp="$dir/.icons.theme.new"
    printf '%s\n' "$icons" | write_new "$tmp" "$ICONS_CAP" 0644 || refuse "could not write $dir/icons.theme"
    mv -f -- "$tmp" "$dir/icons.theme" || refuse "could not write $dir/icons.theme"
  fi
  say "$dir"
}

# ------------------------------------------------------------ the preview
#
# The mock desktop, grabbed by the QML side into the scratch directory and
# handed here as a path. Re-encoded rather than moved, for the same reason
# `adopt` re-encodes: what lands in a directory the user is about to publish
# should be a file this helper decoded, at the size a preview is meant to be.
cmd_preview() {
  local name path bg dir bin out tmp fmt
  name=$(require_writable_theme "${1:-}") || exit $?
  path="${2:-}"
  bg="${3:-}"
  [[ -n $path ]] || refuse "preview needs a path"
  valid_hex "$bg" || bg="#000000"

  fmt=$(probe_format "$path") || exit $?
  bin=$(magick_bin) || refuse "ImageMagick is not installed" "$EXIT_NO_TOOL"
  dir="$(theme_root)/$name"
  require_dir "$dir"
  out="$dir/preview.png"
  tmp="$dir/.preview.png.new"

  # Fitted into 16:9 and padded with the theme's own background rather than
  # cropped to fill: cropping a mock desktop takes the bar off the top, which
  # is the part of a preview people look at first.
  image_stream "$path" "$fmt" \
    | timeout "$(remaining)" "$bin" "${IM_LIMITS[@]}" "$fmt:-" \
        -auto-orient -resize "${PREVIEW_WIDTH}x${PREVIEW_HEIGHT}" \
        -background "$bg" -gravity Center -extent "${PREVIEW_WIDTH}x${PREVIEW_HEIGHT}" \
        -strip PNG24:- 2>/dev/null \
    | write_new "$tmp" "$IMAGE_CAP" 0644
  if (( PIPESTATUS[0] != 0 || PIPESTATUS[1] != 0 )) || [[ ! -f $tmp ]]; then
    rm -f -- "$tmp"
    refuse "could not draw the preview image"
  fi
  mv -f -- "$tmp" "$out" || refuse "could not write $out"
  say "$out"
}

# -------------------------------------------------------------- compliance
#
# What Omarchy needs from a theme, and what a repository submitted to
# omarchy.org needs on top of it. Reported as `state<TAB>label<TAB>detail`
# lines so a caller formats rather than parses; the exit code is the summary.
#
# Structural only, on purpose. Contrast is decided by the solver in Palette.js,
# and a second copy of that maths here is a second copy that can disagree.

# What omarchy-theme-set drops from a theme it finds a .git in. Each of these
# names a program to launch, so a cloned theme does not get to supply one --
# shipping one anyway is not dangerous, it just silently does nothing.
INSTALL_DENIED='alacritty\.toml|foot\.ini|ghostty\.conf|kitty\.conf|vscode\.json'

verdict() {
  printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}"
}

cmd_verify() {
  local name dir toml line count key seen missing dropped status
  name=$(require_name "${1:-}") || exit $?
  status=0

  dir="$(theme_root)/$name"
  [[ -d $dir && ! -L $dir ]] || refuse "there is no theme of yours called '$name'"

  if [[ -d "$OMARCHY_ROOT/themes/$name" ]]; then
    verdict warn "name" "Omarchy ships a theme called '$name' -- yours overlays it rather than standing alone"
  else
    verdict ok "name" "$name"
  fi

  toml="$dir/colors.toml"
  if [[ ! -f $toml || -L $toml ]]; then
    verdict no "colors.toml" "missing -- it is the whole theme"
    status=1
  else
    count=0
    seen=" "
    while IFS= read -r line; do
      count=$(( count + 1 ))
      (( count > 200 )) && break
      if ! toml_line_ok "$line"; then
        verdict no "colors.toml" "Omarchy cannot use this line: $line"
        status=1
        seen=""
        break
      fi
      [[ $line == *" = "* ]] && seen+="${line%% = *} "
    done < <(head -c "$TOML_CAP" -- "$toml")

    if [[ -n $seen ]]; then
      missing=""
      for key in mode ${TOML_KEYS//|/ }; do
        [[ $seen == *" $key "* ]] || missing+="$key "
      done
      if [[ -n $missing ]]; then
        verdict no "colors.toml" "no value for: ${missing% }"
        status=1
      else
        verdict ok "colors.toml" "mode and all 25 colours"
      fi
    fi
  fi

  count=$(find "$dir/backgrounds" -maxdepth 1 -type f \
            \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
            -printf 'x' 2>/dev/null | wc -c)
  if [[ -d "$dir/backgrounds" && ! -L "$dir/backgrounds" ]] && (( count > 0 )); then
    verdict ok "backgrounds" "$count image$( (( count == 1 )) || printf s )"
  else
    verdict warn "backgrounds" "none -- Omarchy keeps whatever wallpaper is already up"
  fi

  if [[ -f "$dir/icons.theme" && ! -L "$dir/icons.theme" ]]; then
    verdict ok "icons.theme" "$(head -c "$ICONS_CAP" -- "$dir/icons.theme" | tr -dc 'A-Za-z0-9-')"
  else
    verdict warn "icons.theme" "absent -- GNOME icons stay Yaru-blue whatever the accent is"
  fi

  if [[ -f "$dir/preview.png" && ! -L "$dir/preview.png" ]]; then
    verdict ok "preview.png" "the repository listing has something to show"
  else
    verdict warn "preview.png" "absent -- omarchy.org will not merge a theme without a screenshot"
  fi

  dropped=""
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    dropped+="$line "
  done < <(find "$dir" -maxdepth 1 -type f -regextype posix-extended \
             -regex ".*/(.*\.lua|$INSTALL_DENIED)" -printf '%f\n' 2>/dev/null | sort | head -n 20)

  if [[ -n $dropped ]]; then
    verdict warn "dropped once cloned" "${dropped% } -- omarchy-theme-set ignores these in a theme installed from a repository"
  else
    verdict ok "dropped once cloned" "nothing here a clone would lose"
  fi

  exit "$status"
}

# -------------------------------------------------------------- publishing
#
# A theme is published by pushing a git repository and opening a pull request
# against omacom-io/omarchy-site. This builds that repository *beside* the
# theme rather than inside it, and the placement is the point: a `.git` in
# ~/.config/omarchy/themes/<name> is exactly what tells Omarchy the theme came
# from a stranger, and what tells this helper to stop saving there.

# The directory the chooser handed back. Every rule require_dir applies, plus
# one more: it has to already exist. A chooser returns a directory that does.
require_parent_dir() {
  local dir="${1:-}"
  [[ -n $dir ]] || refuse "publishing needs a directory to put the repository in"
  (( ${#dir} <= PATH_CAP )) || refuse "that path is longer than this system can open"
  [[ $dir == /* ]] || refuse "'$dir' is not an absolute path"
  [[ $dir != *$'\n'* ]] || refuse "that is not a path this will write to"
  [[ -d $dir && ! -L $dir && -O $dir ]] || refuse "'$dir' is not a directory of yours to write in"
  printf '%s' "$dir"
}

# A background's filename, joined back onto a path. `find -printf %f` is only
# as trustworthy as the directory it read, so the name is whitelisted rather
# than quoted -- there is no legitimate wallpaper this refuses.
safe_basename() {
  [[ ${1:-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]
}

copy_into_repo() {
  local src="$1" dest="$2"
  [[ -f $src && ! -L $src ]] || return 1
  cp -- "$src" "$dest" 2>/dev/null || refuse "could not copy ${src##*/} into the repository"
  chmod 0644 -- "$dest" 2>/dev/null
  return 0
}

# One hex value out of a colors.toml this helper wrote and has re-validated.
toml_value() {
  sed -n "s/^$1 = \"\(#[0-9a-f]\{6\}\)\"\$/\1/p" -- "$2" 2>/dev/null | head -1
}

# git, if the box has it and the user has an identity. Never fatal: the files
# are already written, and "not a repository yet" is a sentence, not a failure.
git_note() {
  local dir="$1" message="$2"
  command -v git >/dev/null 2>&1 || { printf 'git is not installed, so this is a plain directory for now'; return; }

  if [[ ! -d "$dir/.git" ]]; then
    timeout "$(remaining)" git -c init.defaultBranch=main init -q -- "$dir" >/dev/null 2>&1 \
      || { printf 'git init did not run here'; return; }
  fi
  if [[ -z $(timeout 10 git -C "$dir" config --get user.email 2>/dev/null) ]]; then
    printf 'repository created; set a git identity and commit: git config --global user.email you@example.com'
    return
  fi
  timeout "$(remaining)" git -C "$dir" add -A >/dev/null 2>&1 \
    || { printf 'repository created; git add did not run'; return; }
  if timeout 10 git -C "$dir" diff --cached --quiet 2>/dev/null; then
    printf 'already committed; nothing changed'
    return
  fi
  # --no-verify because any hook here came from the user's init template rather
  # than from this repository, and a theme export is not the place to run one.
  if timeout "$(remaining)" git -C "$dir" commit --no-verify -q -m "$message" >/dev/null 2>&1; then
    printf 'committed'
  else
    printf 'repository created; git commit refused it'
  fi
}

write_repo_readme() {
  local target="$1" name="$2" slug="$3" toml="$target/colors.toml"
  local accent background foreground mode
  [[ -e "$target/README.md" ]] && return 0

  accent=$(toml_value accent "$toml")
  background=$(toml_value background "$toml")
  foreground=$(toml_value foreground "$toml")
  mode=$(sed -n 's/^mode = "\(dark\|light\)"$/\1/p' -- "$toml" 2>/dev/null | head -1)

  {
    printf '# %s — an Omarchy theme\n\n' "$name"
    printf 'A %s theme built with [Theme Forge](https://github.com/kairos-tech-oh/kairos.theme-forge).\n' "${mode:-dark}"
    printf 'Say something here about where it came from — this line is the pitch.\n\n'
    printf '![%s](preview.png)\n\n' "$name"
    printf '## Install\n\n'
    printf '```sh\n'
    printf 'omarchy theme install https://github.com/YOUR-GITHUB-USERNAME/%s.git\n' "$slug"
    printf '```\n\n'
    printf 'That clones this repository into `~/.config/omarchy/themes` and applies it.\n'
    printf 'Switch back to it later with `omarchy theme set %s`.\n\n' "$name"
    printf '## What is in it\n\n'
    printf '| File | Why it is here |\n|---|---|\n'
    printf '| `colors.toml` | the palette, and the whole theme |\n'
    printf '| `icons.theme` | the one setting no Omarchy template derives |\n'
    printf '| `backgrounds/` | the wallpaper(s) |\n'
    printf '| `preview.png` | what the listing shows |\n\n'
    printf 'Omarchy regenerates Alacritty, foot, Ghostty, kitty, btop, Neovim, Helix,\n'
    printf 'Hyprland, Chromium, VS Code, Obsidian and the shell palette from `colors.toml`,\n'
    printf 'so nothing derivable is checked in — a copy here would only drift.\n\n'
    if [[ -n $accent && -n $background && -n $foreground ]]; then
      printf '| Role | Colour |\n|---|---|\n'
      printf '| background | `%s` |\n' "$background"
      printf '| foreground | `%s` |\n' "$foreground"
      printf '| accent | `%s` |\n\n' "$accent"
    fi
    printf '## License\n\nMIT. See [LICENSE](LICENSE).\n'
  } | write_new "$target/.README.md.new" "$DOC_CAP" 0644 || return 1
  mv -f -- "$target/.README.md.new" "$target/README.md"
}

write_repo_license() {
  local target="$1" who year
  [[ -e "$target/LICENSE" ]] && return 0
  who=$(timeout 5 git config --get user.name 2>/dev/null | tr -dc 'A-Za-z0-9 .,_-' | head -c 60)
  [[ -n $who ]] || who="The theme's author"
  year=$(date +%Y)

  {
    printf 'MIT License\n\nCopyright (c) %s %s\n\n' "$year" "$who"
    printf 'Permission is hereby granted, free of charge, to any person obtaining a copy\n'
    printf 'of this software and associated documentation files (the "Software"), to deal\n'
    printf 'in the Software without restriction, including without limitation the rights\n'
    printf 'to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n'
    printf 'copies of the Software, and to permit persons to whom the Software is\n'
    printf 'furnished to do so, subject to the following conditions:\n\n'
    printf 'The above copyright notice and this permission notice shall be included in all\n'
    printf 'copies or substantial portions of the Software.\n\n'
    printf 'THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n'
    printf 'IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n'
    printf 'FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n'
    printf 'AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n'
    printf 'LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n'
    printf 'OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n'
    printf 'SOFTWARE.\n'
  } | write_new "$target/.LICENSE.new" "$DOC_CAP" 0644 || return 1
  mv -f -- "$target/.LICENSE.new" "$target/LICENSE"
}

write_repo_gitignore() {
  local target="$1"
  [[ -e "$target/.gitignore" ]] && return 0
  # The scratch names this helper writes next to a real file, so a crashed
  # export never leaves a half-written one staged.
  printf '.*.new\n*.tmp\n' | write_new "$target/.gitignore.new" "$DOC_CAP" 0644 || return 1
  mv -f -- "$target/.gitignore.new" "$target/.gitignore"
}

# The parent directory to publish into, from the desktop portal. Same treatment
# as cmd_pick: a portal is another program answering over D-Bus, and nothing
# about that makes its reply self-limiting.
cmd_pick_dir() {
  need_tool omarchy-file-select
  BOUNDED_OUT=$(timeout 600 omarchy-file-select \
      --title "Where should the theme repository go?" \
      --directory 2>/dev/null | head -c $(( PATH_CAP + 1 )))
  local status=${PIPESTATUS[0]}
  (( $(printf '%s' "$BOUNDED_OUT" | wc -c) > PATH_CAP )) && refuse "that path is longer than this system can open" "$EXIT_TOO_BIG"
  (( status != 0 )) && exit "$status"
  say "$BOUNDED_OUT"
}

# Prints the repository path on the first line and what git did on the second.
cmd_export() {
  local name parent src target slug file count note
  name=$(require_writable_theme "${1:-}") || exit $?
  parent=$(require_parent_dir "${2:-}") || exit $?

  src="$(theme_root)/$name"
  [[ -d $src && ! -L $src ]] || refuse "there is no theme of yours called '$name'"
  [[ -f "$src/colors.toml" ]] || refuse "'$name' has no colors.toml yet -- save it first"

  slug="omarchy-$name-theme"
  target="$parent/$slug"

  # An existing target is only ever one of these to refresh, and "holds a
  # colors.toml" is the whole test. Anything else under that name is somebody's
  # work, and this does not get to write into it.
  if [[ -e $target ]]; then
    [[ -d $target && ! -L $target && -O $target ]] || refuse "$target is not a directory of yours"
    [[ -f "$target/colors.toml" ]] || refuse "$target already exists and is not a theme repository"
  fi
  require_dir "$target"
  require_dir "$target/backgrounds"

  copy_into_repo "$src/colors.toml" "$target/colors.toml" || refuse "could not read $src/colors.toml"
  copy_into_repo "$src/icons.theme" "$target/icons.theme" || true
  copy_into_repo "$src/preview.png" "$target/preview.png" || true

  count=0
  while IFS= read -r file; do
    (( count >= 20 )) && break
    safe_basename "$file" || continue
    copy_into_repo "$src/backgrounds/$file" "$target/backgrounds/$file" || continue
    count=$(( count + 1 ))
  done < <(find "$src/backgrounds" -maxdepth 1 -type f \
             \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
             -printf '%f\n' 2>/dev/null | sort | head -n 40)

  # Only ever written when absent. On a second export the user's own edits to
  # the README are what should survive, not this template.
  write_repo_readme "$target" "$name" "$slug" || refuse "could not write $target/README.md"
  write_repo_license "$target" || refuse "could not write $target/LICENSE"
  write_repo_gitignore "$target" || refuse "could not write $target/.gitignore"

  note=$(git_note "$target" "$name: an Omarchy theme")
  say "$target"
  say "$note"
}

cmd_apply() {
  local name
  name=$(require_name "${1:-}") || exit $?
  [[ -d "$THEMES_DIR/$name" || -d "$OMARCHY_ROOT/themes/$name" ]] \
    || refuse "there is no theme called '$name'"
  need_tool omarchy-theme-set
  # Its output is progress chatter; the exit code is the answer.
  timeout "$(remaining)" omarchy-theme-set "$name" >/dev/null 2>&1
  local status=$?
  (( status == 124 )) && refuse "applying the theme took too long" "$EXIT_TIMEOUT"
  (( status != 0 )) && refuse "omarchy-theme-set refused '$name'"
  say "$name"
}

cmd_list() {
  run_bounded "$LIST_CAP" find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' \
    || refuse "could not list your themes"
  say "$BOUNDED_OUT"
}

# The user themes Theme Forge will *not* write to, and the UI needs to know
# before it offers. Same two rules require_writable_theme enforces: a theme
# cloned from a git repository came from someone else, and a symlinked one is a
# working copy living somewhere this has no business writing through.
cmd_list_wip() {
  [[ -d $WIP_DIR ]] || exit 0
  run_bounded "$LIST_CAP" find "$WIP_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' \
    || refuse "could not list your in-progress themes"
  say "$BOUNDED_OUT"
}

# Removing an in-progress theme once it has been kept as a real one. The only
# rm -rf in this plugin, and it is bounded three ways: the name has passed the
# whitelist, the parent is this plugin's own verified state directory, and the
# target has to actually be a directory that is not a symlink.
cmd_discard_wip() {
  local name dir
  name=$(require_name "${1:-}") || exit $?
  state_dir >/dev/null || refuse "$STATE_DIR is not a directory this can write to"
  [[ -d $WIP_DIR && ! -L $WIP_DIR && -O $WIP_DIR ]] || exit 0
  dir="$WIP_DIR/$name"
  [[ -d $dir && ! -L $dir ]] || exit 0
  [[ -O $dir ]] || refuse "$dir is not yours"
  rm -rf -- "$dir"
  say "$name"
}

cmd_locked() {
  local name
  [[ -d $THEMES_DIR ]] || exit 0
  run_bounded "$LIST_CAP" find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' \
    || refuse "could not list your themes"
  while IFS= read -r name; do
    valid_name "$name" || continue
    if [[ -L "$THEMES_DIR/$name" || -e "$THEMES_DIR/$name/.git" ]]; then
      say "$name"
    fi
  done <<<"$BOUNDED_OUT"
}

cmd_stock() {
  run_bounded "$LIST_CAP" find "$OMARCHY_ROOT/themes" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' \
    || refuse "could not list Omarchy's themes"
  say "$BOUNDED_OUT"
}

cmd_current() {
  need_tool python3
  timeout "$(remaining)" python3 "$READER" read "$CURRENT_NAME_FILE" 128 2>/dev/null
  exit 0
}

cmd_load() {
  local name path
  name=$(require_name "${1:-}") || exit $?
  path="$(theme_root)/$name/colors.toml"
  [[ -f $path ]] || path="$THEMES_DIR/$name/colors.toml"
  [[ -f $path ]] || path="$OMARCHY_ROOT/themes/$name/colors.toml"
  need_tool python3
  timeout "$(remaining)" python3 "$READER" read "$path" "$TOML_CAP"
  exit $?
}

cmd_draft_save() {
  local dir body tmp
  dir=$(state_dir) || refuse "could not create $STATE_DIR"
  body=$(head -c $(( DRAFT_CAP + 1 )))
  if (( $(printf '%s' "$body" | wc -c) > DRAFT_CAP )); then
    refuse "that draft is larger than expected" "$EXIT_TOO_BIG"
  fi
  tmp="$dir/.draft.json.new"
  printf '%s\n' "$body" | write_new "$tmp" "$DRAFT_CAP" || refuse "could not write the draft"
  mv -f -- "$tmp" "$dir/draft.json" || refuse "could not write the draft"
}

cmd_prefs_save() {
  local dir body tmp
  dir=$(state_dir) || refuse "could not create $STATE_DIR"
  body=$(head -c $(( PREFS_CAP + 1 )))
  if (( $(printf '%s' "$body" | wc -c) > PREFS_CAP )); then
    refuse "those preferences are larger than expected" "$EXIT_TOO_BIG"
  fi
  tmp="$dir/.prefs.json.new"
  printf '%s\n' "$body" | write_new "$tmp" "$PREFS_CAP" || refuse "could not write the preferences"
  mv -f -- "$tmp" "$dir/prefs.json" || refuse "could not write the preferences"
}

cmd_prefs_load() {
  local dir
  dir=$(state_dir) || exit 0
  need_tool python3
  timeout "$(remaining)" python3 "$READER" read "$dir/prefs.json" "$PREFS_CAP" 2>/dev/null
  exit 0
}

cmd_draft_load() {
  local dir
  dir=$(state_dir) || exit 0
  need_tool python3
  timeout "$(remaining)" python3 "$READER" read "$dir/draft.json" "$DRAFT_CAP" 2>/dev/null
  exit 0
}

# --------------------------------------------------------------- dispatch

command="${1:-}"
shift 2>/dev/null || true

case "$command" in
  scratch)    cmd_scratch "$@" ;;
  pick)       cmd_pick "$@" ;;
  probe)      cmd_probe "$@" ;;
  quantize)   cmd_quantize "$@" ;;
  thumb)      cmd_thumb "$@" ;;
  wallpaper)  cmd_wallpaper "$@" ;;
  adopt)      cmd_adopt "$@" ;;
  save)       cmd_save "$@" ;;
  preview)    cmd_preview "$@" ;;
  verify)     cmd_verify "$@" ;;
  pick-dir)   cmd_pick_dir "$@" ;;
  export)     cmd_export "$@" ;;
  apply)      cmd_apply "$@" ;;
  list)       cmd_list "$@" ;;
  locked)     cmd_locked "$@" ;;
  list-wip)   cmd_list_wip "$@" ;;
  discard-wip) cmd_discard_wip "$@" ;;
  stock)      cmd_stock "$@" ;;
  current)    cmd_current "$@" ;;
  load)       cmd_load "$@" ;;
  draft-save) cmd_draft_save "$@" ;;
  prefs-save) cmd_prefs_save "$@" ;;
  prefs-load) cmd_prefs_load "$@" ;;
