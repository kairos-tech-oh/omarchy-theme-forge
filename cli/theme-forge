#!/bin/bash

# theme-forge -- open and inspect the Theme Forge designer from a terminal.
#
# The designer itself is a window owned by omarchy-shell, so this is a front end for
# the shell's IPC rather than a program that draws anything. It exists because
#
#     omarchy-shell shell toggle kairos.theme-forge
#
# is a lot to type and impossible to guess, and because `edit` and `doctor`
# have no equivalent at all.
#
# Deliberately not here: rolling or saving a theme headlessly. All of that lives
# in Palette.js, which runs inside the shell's QML engine, and standing up a
# second way to invoke it would mean a second copy of the contrast solver. One
# source of truth for the colour maths is worth more than a headless roller.
#
#   theme-forge                open the designer (toggles, like the keybinding)
#   theme-forge open|close
#   theme-forge edit <name>    open it with an existing theme loaded
#   theme-forge list           what is installed, and which are yours to edit
#   theme-forge doctor         check the install and its dependencies
#   theme-forge help

set -uo pipefail

PLUGIN_ID="kairos.theme-forge"
PLUGIN_DIR="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
HELPER="$PLUGIN_DIR/helper/theme-forge"
THEMES_DIR="$HOME/.config/omarchy/themes"
OMARCHY_ROOT="${OMARCHY_PATH:-/usr/share/omarchy}"

# Colour only when someone is watching. Piped into anything, this stays plain.
if [[ -t 1 ]]; then
  DIM=$'\e[2m'; BOLD=$'\e[1m'; GREEN=$'\e[32m'; RED=$'\e[31m'; YELLOW=$'\e[33m'; OFF=$'\e[0m'
else
  DIM=""; BOLD=""; GREEN=""; RED=""; YELLOW=""; OFF=""
fi

die() {
  printf '%stheme-forge:%s %s\n' "$RED" "$OFF" "$1" >&2
  exit "${2:-1}"
}

require_installed() {
  [[ -x $HELPER ]] || die "Theme Forge is not installed at $PLUGIN_DIR
Install it with:  omarchy plugin add <repo-url> --enable"
}

# The shell only loads a third-party plugin that is listed in shell.json.
# Without this check, `open` silently does nothing and there is no clue why.
enabled() {
  python3 - "$PLUGIN_ID" <<'PY' 2>/dev/null
import json, os, sys
path = os.path.expanduser("~/.config/omarchy/shell.json")
try:
    with open(path) as handle:
        config = json.load(handle)
except Exception:
    sys.exit(1)
sys.exit(0 if any(p.get("id") == sys.argv[1] for p in config.get("plugins", [])) else 1)
PY
}

require_enabled() {
  enabled && return 0
  die "$PLUGIN_ID is installed but not enabled.
Enable it with:  omarchy plugin enable $PLUGIN_ID"
}

# A theme name is about to become a directory and an IPC argument, so it gets
# the same whitelist the plugin applies everywhere else. Refused, not repaired.
valid_name() {
  [[ -n ${1:-} && ${#1} -le 32 && $1 =~ ^[a-z0-9][a-z0-9-]*$ ]]
}

cmd_open() { require_installed; require_enabled; omarchy-shell shell summon "$PLUGIN_ID" '{}' >/dev/null; }
cmd_close() { require_installed; omarchy-shell shell hide "$PLUGIN_ID" >/dev/null; }
cmd_toggle() { require_installed; require_enabled; omarchy-shell shell toggle "$PLUGIN_ID" '{}' >/dev/null; }

cmd_edit() {
  local name="${1:-}"
  require_installed
  require_enabled
  [[ -n $name ]] || die "which theme?  theme-forge edit <name>"
  name=${name,,}
  valid_name "$name" || die "'$name' is not a theme name (lowercase letters, numbers and dashes)"
  [[ -f "$THEMES_DIR/$name/colors.toml" || -f "$OMARCHY_ROOT/themes/$name/colors.toml" ]] \
    || die "there is no theme called '$name'.  theme-forge list"
  # The payload reaches Overlay.open(), which re-validates the name before it
  # loads anything -- this is a convenience, not the guard.
  omarchy-shell shell summon "$PLUGIN_ID" "{\"theme\":\"$name\"}" >/dev/null
}

cmd_list() {
  require_installed
  local current name
  current=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)

  # Three groups, because "can Theme Forge save over this?" has three different
  # answers and they are the reason a listing is worth having at all. The rules
  # are the ones require_writable_theme enforces in the helper, so what is shown
  # here is what Save will actually do.
  local -a mine=() cloned=()
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    if [[ -L "$THEMES_DIR/$name" || -e "$THEMES_DIR/$name/.git" ]]; then
      cloned+=("$name")
    else
      mine+=("$name")
    fi
  done < <("$HELPER" list 2>/dev/null | sort)

  show() {
    local name="$1" note="${2:-}"
    if [[ $name == "$current" ]]; then
      printf '  %s%-22s%s %sin use%s%s\n' "$GREEN" "$name" "$OFF" "$DIM" "$OFF" "${note:+  $note}"
    else
      printf '  %-22s %s\n' "$name" "${note:+       $note}"
    fi
  }

  printf '%sYours%s %s-- Save writes straight back to these%s\n' "$BOLD" "$OFF" "$DIM" "$OFF"
  if (( ${#mine[@]} )); then
    for name in "${mine[@]}"; do show "$name"; done
  else
    printf '  %snone yet -- press Ctrl+R in the designer and name one%s\n' "$DIM" "$OFF"
  fi

  if (( ${#cloned[@]} )); then
    printf '\n%sInstalled from a repository%s %s-- open to edit, saving needs a new name%s\n' \
      "$BOLD" "$OFF" "$DIM" "$OFF"
    for name in "${cloned[@]}"; do
      if [[ -L "$THEMES_DIR/$name" ]]; then
        show "$name" "${DIM}symlinked working copy${OFF}"
      else
        show "$name" "${DIM}git${OFF}"
      fi
    done
  fi

  printf '\n%sShipped with Omarchy%s %s-- open to start from one, saving needs a new name%s\n' \
    "$BOLD" "$OFF" "$DIM" "$OFF"
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    show "$name"
  done < <("$HELPER" stock 2>/dev/null | sort)
}

# Is Theme Forge's key claimed by anything else?
#
# Hyprland runs *every* bind that matches a key, in registration order -- the
# loop in its keybind manager sets `found` and carries on rather than breaking.
# So a second bind on the same key does not override Theme Forge and is not
# overridden by it: both fire, on every press, and nothing says so.
# `hyprctl configerrors` stays empty and the log stays quiet, because upstream
# considers duplicate binds legitimate rather than a mistake to report.
#
# That leaves `hyprctl binds` as the only place the truth is visible, so this is
# where the check has to come from. Read-only: it reports, and never edits
# anyone's Hyprland config.
keybind_status() {
  python3 - "$PLUGIN_ID" <<'PY' 2>/dev/null || printf 'warn\tcould not read the keybindings from hyprctl\n'
import json, os, re, subprocess, sys

plugin_id = sys.argv[1]

# Hyprland's modmask bits, from its own KeybindManager.
MODS = {"SHIFT": 1, "CAPS": 2, "CTRL": 4, "CONTROL": 4, "ALT": 8, "MOD2": 16,
        "MOD3": 32, "SUPER": 64, "LOGO": 64, "MOD5": 128}

# `hyprctl binds` is desktop state, not first-party data. Its size and every one
# of its fields are chosen by whoever wrote the Hyprland config -- and a bind
# description is free text that ends up on this terminal. So the reply is
# bounded before it is parsed, and each description is bounded and stripped
# before it is printed.
#
# A 229-bind config measured 96 KiB. 1 MiB is ten times that and is still a hard
# ceiling on what this can be made to hold.
BINDS_CAP = 1024 * 1024
CONFIG_CAP = 1024 * 1024
DESCRIPTION_MAX = 60


def clean(text):
    """A description, safe to print on a terminal and to sit inside a list."""
    out = re.sub(r"[\x00-\x1f\x7f]", " ", str(text))
    out = out.strip()
    if len(out) > DESCRIPTION_MAX:
        out = out[:DESCRIPTION_MAX - 1] + "\u2026"
    return out or "(no description)"


def bounded_output(argv, cap):
    """Read at most cap+1 bytes from a command, stopping it at the ceiling.

    cap+1 so "exactly at the limit" is distinguishable from "truncated" -- a
    JSON document cut at the cap would not parse anyway, but silently treating a
    truncated bind list as the whole list is how a conflict goes unreported.
    """
    # The kill() here is not the dangerous kind. It targets a child this line
    # just spawned, through the Popen handle that owns it -- a single positive
    # PID the kernel keeps reserved until wait() reaps it, so there is no stored
    # PID to go stale, no identity to confuse, and no process group to hit. It
    # is what stops a producer that ignores the closed pipe from lingering.
    proc = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    try:
        data = proc.stdout.read(cap + 1)
    finally:
        proc.stdout.close()
        proc.kill()
        proc.wait(timeout=5)
    if len(data) > cap:
        raise ValueError("reply larger than %d bytes" % cap)
    return data


def binds_for(text):
    """The keys an o.bind line claims, from any Hyprland config that names us."""
    return re.findall(r'o\.bind\(\s*"([^"]+)"', text)


def modmask_and_key(spec):
    parts = [p.strip().upper() for p in spec.split("+") if p.strip()]
    mask = 0
    key = ""
    for part in parts:
        if part in MODS:
            mask |= MODS[part]
        else:
            key = part
    return mask, key


config = os.path.expanduser("~/.config/hypr")
claimed = []
for root, _dirs, files in os.walk(config):
    for name in files:
        path = os.path.join(root, name)
        try:
            # Bounded: a config file is a few KiB, and one enormous line would
            # otherwise be read whole before anything looked at it.
            with open(path, encoding="utf-8", errors="replace") as handle:
                for line in handle.read(CONFIG_CAP).splitlines():
                    if plugin_id in line:
                        claimed.extend(binds_for(line))
        except OSError:
            continue

if not claimed:
    print("no\tnone found in ~/.config/hypr -- this command still works")
    raise SystemExit(0)

try:
    live = json.loads(bounded_output(["hyprctl", "binds", "-j"], BINDS_CAP))
    if not isinstance(live, list):
        raise ValueError("not a list of binds")
except Exception:
    print("ok\t%s (could not check it for conflicts)" % clean(claimed[0]))
    raise SystemExit(0)

lines = []
conflicted = False
for spec in claimed:
    mask, key = modmask_and_key(spec)
    rivals = [clean(b.get("description"))
              for b in live
              if isinstance(b, dict)
              and b.get("modmask") == mask and str(b.get("key", "")).upper() == key]
    if len(rivals) <= 1:
        lines.append(("ok", clean(spec), []))
        continue
    conflicted = True
    lines.append(("warn", "%d binds claim %s -- Hyprland runs all of them" % (len(rivals), clean(spec)),
                  ["- " + r for r in rivals]
                  + ['fix: hl.unbind("%s") above the Theme Forge line' % clean(spec)]))

state, summary, extra = lines[0]
if conflicted:
    state, summary, extra = next(l for l in lines if l[0] == "warn")
print("%s\t%s" % (state, summary))
for line in extra:
    print(line)
PY
}

cmd_doctor() {
  local status=0
  # Three states, not two. A keybind conflict does not stop Theme Forge working
  # -- it opens exactly as it should, and then something else opens too -- so it
  # is a warning the user must act on rather than a missing dependency, and it
  # does not flip the exit code.
  local warned=0
  check() {
    local label="$1" detail="${3:-}"
    case "$2" in
      ok)   printf '  %sok  %s %-28s %s%s%s\n' "$GREEN" "$OFF" "$label" "$DIM" "$detail" "$OFF" ;;
      warn) printf '  %s!!  %s %-28s %s\n' "$YELLOW" "$OFF" "$label" "$detail"; warned=1 ;;
      *)    printf '  %s--  %s %-28s %s\n' "$RED" "$OFF" "$label" "$detail"; status=1 ;;
    esac
  }

  printf '%sTheme Forge%s\n' "$BOLD" "$OFF"

  if [[ -x $HELPER ]]; then
    check "installed" ok "$PLUGIN_DIR"
  else
    check "installed" no "not found at $PLUGIN_DIR"
  fi

  if enabled; then
    check "enabled in shell.json" ok
  else
    check "enabled in shell.json" no "run: omarchy plugin enable $PLUGIN_ID"
  fi

  if omarchy-shell shell ping >/dev/null 2>&1; then
    check "omarchy-shell responding" ok
  else
    check "omarchy-shell responding" no "the shell is not running"
  fi

  # A keybinding is optional -- Theme Forge has no bar presence, so without one
  # this command is the only way in, which is worth saying out loud.
  # Reported as `<state>\t<summary>\n<extra lines...>`, so the conflict case can
  # say more than one line without the caller parsing anything.
  local keybind_report state summary
  keybind_report=$(keybind_status)
  state=${keybind_report%%$'\t'*}
  summary=$(printf '%s' "${keybind_report#*$'\t'}" | head -1)
  check "keybinding" "$state" "$summary"
  printf '%s\n' "$keybind_report" | tail -n +2 | while IFS= read -r line; do
    [[ -n $line ]] && printf '       %s%s%s\n' "$DIM" "$line" "$OFF"
  done

  if command -v magick >/dev/null 2>&1 || command -v convert >/dev/null 2>&1; then
    check "ImageMagick" ok "images and generated backgrounds"
  else
    check "ImageMagick" no "backgrounds and image seeding are off without it"
  fi

  if command -v python3 >/dev/null 2>&1; then
    check "python3" ok "bounded file reads"
  else
    check "python3" no "required"
  fi

  local scratch
  if scratch=$("$HELPER" scratch 2>/dev/null) && [[ -n $scratch ]]; then
    check "private scratch directory" ok "$scratch"
  else
    check "private scratch directory" no "images will be unavailable, palette editing still works"
  fi

  if (( status != 0 )); then
    printf '\n%ssomething above needs attention%s\n' "$YELLOW" "$OFF"
  elif (( warned )); then
    printf '\n%severything Theme Forge needs is here -- but see the warning above%s\n' "$YELLOW" "$OFF"
  else
    printf '\n%severything Theme Forge needs is here%s\n' "$GREEN" "$OFF"
  fi
  return "$status"
}

cmd_help() {
  cat <<USAGE
${BOLD}theme-forge${OFF} -- the Omarchy theme designer

  ${BOLD}theme-forge${OFF}                 open the designer (toggles it, like the keybinding)
  ${BOLD}theme-forge open${OFF}            open it
  ${BOLD}theme-forge close${OFF}           close it
  ${BOLD}theme-forge edit${OFF} <name>     open it with an existing theme loaded
  ${BOLD}theme-forge list${OFF}            what is installed, and which are yours to edit
  ${BOLD}theme-forge doctor${OFF}          check the install and its dependencies
  ${BOLD}theme-forge help${OFF}            this

${DIM}Inside the designer:  Ctrl+R roll   Ctrl+S save   Ctrl+Enter apply   Esc close${OFF}
USAGE
}

case "${1:-toggle}" in
  ""|toggle)        cmd_toggle ;;
  open|show)        cmd_open ;;
  close|hide)       cmd_close ;;
  edit)             shift; cmd_edit "$@" ;;
  list|ls)          cmd_list ;;
  doctor|check)     cmd_doctor ;;
  help|-h|--help)   cmd_help ;;
  *)                printf '%stheme-forge:%s unknown command %s\n\n' "$RED" "$OFF" "'$1'" >&2; cmd_help >&2; exit 1 ;;
esac
